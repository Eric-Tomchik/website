# ── Convex ──
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud
CONVEX_DEPLOY_KEY=prod:your-deploy-key
# Server-to-server master key. Set in BOTH Cloudflare and Convex; never expose to browser code.
CONVEX_AUTH_SECRET=your-long-random-server-secret
# Capability signing key. Set the SAME independent random value in BOTH Cloudflare and Convex.
CONVEX_ADMIN_SESSION_SECRET=your-independent-capability-signing-secret

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://erictomchik.com

# ── Admin ──
ADMIN_PASSWORD=your-secret-admin-password
# Independent HMAC key for the httpOnly admin_session cookie (Cloudflare only).
ADMIN_SESSION_SECRET=your-independent-session-signing-secret
# Optional TOTP secret after 2FA setup.
ADMIN_TOTP_SECRET=your-totp-secret

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── PayPal ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx

# ── Google Analytics ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SA_CREDENTIALS={"type":"service_account","project_id":"..."}

# ── Google Search Console (optional) ──
GSC_SITE_URL=https://erictomchik.com

# ── Social Media (optional) ──
FB_PAGE_ID=your-page-id
FB_PAGE_ACCESS_TOKEN=your-token
IG_USER_ID=your-ig-user-id
IG_ACCESS_TOKEN=your-token
X_API_KEY=your-key
X_API_SECRET=your-secret
X_ACCESS_TOKEN=your-token
X_ACCESS_SECRET=your-secret
LINKEDIN_ACCESS_TOKEN=your-token
LINKEDIN_PERSON_URN=urn:li:person:your-id

# ── Meta Pixel (optional) ──
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id
